# LLM Provider: "groq" (recommended) or "ollama"
LLM_PROVIDER=groq

# Groq API key — get yours at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
# Default model (must be one Groq currently serves)
GROQ_MODEL=openai/gpt-oss-20b
# Comma-separated models clients may pick
# ALLOWED_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b,qwen/qwen3.8-27b

# Ollama (only needed when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://ollama:11434

# Signing key for login tokens. REQUIRED in production; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Sessions: short-lived access token + rotating refresh cookie
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=14
# Secure cookie flag: auto (HTTPS only), true, or false
# COOKIE_SECURE=auto
# Public URL used in password-reset links
APP_BASE_URL=http://localhost:8000

# SMTP for password-reset email. Leave SMTP_HOST empty to print emails to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DocuMind <no-reply@example.com>

# Demo login buttons are hidden in production builds. To show them, put
# VITE_SHOW_DEMO_LOGINS=true in frontend/.env before `npm run build`
# (build-time setting; never enable it for a real deployment).

# Database. Defaults to SQLite at data/documind.db when unset.
# DATABASE_URL=postgresql+psycopg://documind:documind@localhost:5432/documind

# Browser origins allowed to call the API (comma-separated)
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173

# Run the ingest worker inside the API process (set false if you run `python -m jobs`)
INGEST_WORKER_ENABLED=true
MAX_UPLOAD_MB=50
